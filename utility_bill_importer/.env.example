# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file (it is git-ignored).

# --- IMAP email access ---
# For Gmail: enable 2-Step Verification, then create an "App Password"
#   https://myaccount.google.com/apppasswords
# Use that 16-character app password below (NOT your normal Gmail password).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_16_char_app_password

# Mailbox / Gmail label to scan for bills.
# Tip: in Gmail create a filter that auto-labels utility bills as "Bills".
IMAP_FOLDER=Bills
